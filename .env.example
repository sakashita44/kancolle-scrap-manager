# 艦これ工廠任務廃棄マネージャー - デプロイ設定

# ==================================================
# ビルド設定
# ==================================================
# サブディレクトリにデプロイする場合のベースパス
# ルートにデプロイする場合は設定不要（デフォルト: /）
# 例: VITE_BASE_PATH=/kancolle-scrap-manager/
# VITE_BASE_PATH=/

# アプリケーションバージョンは package.json から自動注入される（ここでは設定しない）

# ==================================================
# FTP デプロイ設定（本番環境アップロード用）
# ==================================================
# FTPサーバーホスト名
FTP_HOST=ftp.example.com

# FTPユーザー名
FTP_USER=your-ftp-username

# FTPパスワード
FTP_PASSWORD=your-ftp-password

# サーバー上の公開ディレクトリ（例: /public_html）
# 注意: VITE_BASE_PATH と整合性を保つこと
# 例: VITE_BASE_PATH=/app/ なら FTP_REMOTE_PATH=/public_html/app
FTP_REMOTE_PATH=/path/to/public/directory

# ローカルのビルド出力ディレクトリ（デフォルト: dist）
FTP_LOCAL_PATH=dist

# ==================================================
# その他の設定（ポート番号、除外ファイル等）は
# scripts/deploy.js 内で直接管理しています
# ==================================================

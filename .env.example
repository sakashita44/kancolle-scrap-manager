# 艦これ工廠任務廃棄マネージャー 環境変数設定例
# このファイルを .env にコピーして使用してください

# GitHub Pages URL（公式マスタデータのプライマリソース）
# 例: https://sakashita44.github.io/kancolle-scrap-manager
VITE_GITHUB_PAGES_URL=https://your-username.github.io/your-repo-name

# GitHubリポジトリURL（エラー報告先）
# 例: https://github.com/sakashita44/kancolle-scrap-manager
VITE_GITHUB_REPO_URL=https://github.com/your-username/your-repo-name

# 問い合わせフォームURL（オプション）
# Critical エラー時のみ表示される
# Googleフォーム等のURLを設定（スパム対策のためCritical時のみ表示）
# 未設定の場合はGitHubリポジトリのみが表示される
VITE_CONTACT_FORM_URL=

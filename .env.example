# 艦これ工廠任務廃棄マネージャー - デプロイ設定

# ==================================================
# FTP デプロイ設定（本番環境アップロード用）
# ==================================================
# FTPサーバーホスト名
FTP_HOST=ftp.example.com

# FTPユーザー名
FTP_USER=your-ftp-username

# FTPパスワード
FTP_PASSWORD=your-ftp-password

# サーバー上の公開ディレクトリ（例: /public_html）
FTP_REMOTE_PATH=/path/to/public/directory

# ローカルのビルド出力ディレクトリ（通常は dist/）
FTP_LOCAL_PATH=dist

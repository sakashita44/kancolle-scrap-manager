{
    "name": "kancolle-scrap-manager",
    "version": "2.1.0",
    "description": "艦これで複数の廃棄任務を並列で遂行する際に，廃棄すべき装備の必要最小限リスト(最適解)を算出し，無駄な廃棄を防ぐことを目的としたWebアプリケーション",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "deploy": "node scripts/deploy.js",
        "prepare": "husky",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint \"src/**/*.{ts,tsx}\" && markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#dist\"",
        "format": "prettier --write \"**/*.{ts,tsx,json,md}\" && eslint --fix \"src/**/*.{ts,tsx}\" && markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\" \"#dist\""
    },
    "dependencies": {
        "@hookform/resolvers": "^5.2.2",
        "clsx": "^2.1.1",
        "lucide-react": "^0.468.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.69.0",
        "tailwind-merge": "^3.4.0",
        "zod": "^4.1.13",
        "zustand": "^5.0.11"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.3",
        "@types/node": "^25.3.3",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "dotenv": "^17.2.3",
        "eslint": "^9.39.3",
        "eslint-plugin-react-hooks": "^5.2.0",
        "ftp-deploy": "^2.4.7",
        "globals": "^15.15.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.2",
        "markdownlint-cli2": "^0.20.0",
        "postcss": "^8.4.49",
        "prettier": "^3.8.1",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1",
        "vite": "^6.0.3",
        "vitest": "^4.0.18"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sakashita44/kancolle-scrap-manager.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/sakashita44/kancolle-scrap-manager/issues"
    },
    "homepage": "https://github.com/sakashita44/kancolle-scrap-manager#readme"
}
